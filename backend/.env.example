# ==========================================================================
# Ethara backend environment — copy to .env and adjust as needed.
# ==========================================================================

# --- Database ---
# Postgres connection. Format: postgresql://<user>:<password>@<host>:<port>/<db>
# Default dev role/password/db (created in the README setup step):
#   user: ethara_user   password: ethara_pass   db: ethara_db
DATABASE_URL=postgresql://ethara_user:ethara_pass@localhost:5432/ethara_db

# --- Auth (JWT) ---
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Assistant ---
# "fallback" = built-in rule-based assistant (no external key needed).
# Set to "openai" and provide OPENAI_API_KEY only if using an external LLM.
AI_PROVIDER=fallback
OPENAI_API_KEY=

# --- App ---
APP_ENV=development
# Comma-separated origins allowed by CORS (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================================================
# Demo login credentials (created by `python -m scripts.seed_db`)
# Use these to sign in at the frontend after seeding.
#   ADMIN     -> admin@ethara.ai            / Admin@123     (full write access)
#   HR        -> hr@ethara.ai               / Hr@12345      (full write access)
#   EMPLOYEE  -> <printed by seed script>   / Employee@123  (read-only)
# The exact seeded EMPLOYEE email is printed when the seed script finishes.
# ==========================================================================
